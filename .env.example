# Local runs only. Copy this file to .env and paste your Hugging Face token (never commit .env).
#   cp .env.example .env
# The token must belong to an account that has accepted the Llama 3.2 licence:
#   https://huggingface.co/meta-llama/Llama-3.2-3B-Instruct
# Leave it empty to use the token saved by `huggingface-cli login`.
# On Kaggle, do not use this file: add the token as a Kaggle Secret named HF_TOKEN instead.
HF_TOKEN=
